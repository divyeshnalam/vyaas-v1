<div class="max-w-7xl mx-auto">
  <!-- Dashboard Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Resume Analysis Dashboard</h1>
    <p class="text-gray-600 mt-2">Complete profile analysis based on your resume</p>
  </div>

  <!-- ATS Score Section -->
  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-lg p-8 mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Overall Resume Score</h2>

    <!-- Circular Score Display -->
    <div class="flex justify-center items-center mb-8">
      <div class="relative w-56 h-56">
        <svg class="w-56 h-56 transform -rotate-90" viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="85" stroke="#e5e7eb" stroke-width="18" fill="none"/>
          <circle
            cx="100"
            cy="100"
            r="85"
            stroke="url(#scoreGradient)"
            stroke-width="18"
            fill="none"
            stroke-dasharray={534.07}
            stroke-dashoffset={534.07 * (1 - (get_ats_final_score(assigns) / 100))}
            stroke-linecap="round"
          />
        </svg>
        <defs>
          <linearGradient id="scoreGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
          </linearGradient>
        </defs>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <div class="text-6xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">
            <%= get_ats_final_score(assigns) %>
          </div>
          <div class="text-lg text-gray-600 mt-1">out of 100</div>
        </div>
      </div>
    </div>

    <!-- Score Metrics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Completeness Card -->
      <div
        phx-click="toggle_feedback"
        phx-value-section="completeness"
        class="bg-white border-2 border-blue-200 rounded-xl p-5 cursor-pointer hover:shadow-lg hover:border-blue-400 transition-all duration-200"
      >
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <span class="font-semibold text-gray-700">Completeness</span>
          </div>
          <span class={"text-xs font-bold px-3 py-1 rounded-full #{get_rating_class(get_completeness_score(assigns))}"}>
            <%= get_rating(get_completeness_score(assigns)) %>
          </span>
        </div>
        <div class={"text-4xl font-bold mb-2 #{get_score_color(get_completeness_score(assigns))}"}>
          <%= get_completeness_score(assigns) %><span class="text-xl text-gray-400">/100</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-3 mb-3">
          <div class={"h-3 rounded-full transition-all duration-500 #{get_bar_color(get_completeness_score(assigns))}"} style={"width: #{get_completeness_score(assigns)}%"}></div>
        </div>
        <p class="text-sm text-gray-600"><%= get_completeness_message(assigns) %></p>
        <p class="text-xs text-blue-600 mt-3 flex items-center gap-1 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Click for detailed feedback
        </p>
      </div>

      <!-- Relevance Card -->
      <div
        phx-click="toggle_feedback"
        phx-value-section="relevance"
        class="bg-white border-2 border-purple-200 rounded-xl p-5 cursor-pointer hover:shadow-lg hover:border-purple-400 transition-all duration-200"
      >
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <span class="font-semibold text-gray-700">Relevance</span>
          </div>
          <span class={"text-xs font-bold px-3 py-1 rounded-full #{get_rating_class(get_relevance_score(assigns))}"}>
            <%= get_rating(get_relevance_score(assigns)) %>
          </span>
        </div>
        <div class={"text-4xl font-bold mb-2 #{get_score_color(get_relevance_score(assigns))}"}>
          <%= get_relevance_score(assigns) %><span class="text-xl text-gray-400">/100</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-3 mb-3">
          <div class={"h-3 rounded-full transition-all duration-500 #{get_bar_color(get_relevance_score(assigns))}"} style={"width: #{get_relevance_score(assigns)}%"}></div>
        </div>
        <p class="text-sm text-gray-600"><%= get_relevance_message(assigns) %></p>
        <p class="text-xs text-purple-600 mt-3 flex items-center gap-1 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Click for detailed feedback
        </p>
      </div>

      <!-- Sanity Check Card -->
      <div
        phx-click="toggle_feedback"
        phx-value-section="sanity"
        class="bg-white border-2 border-amber-200 rounded-xl p-5 cursor-pointer hover:shadow-lg hover:border-amber-400 transition-all duration-200"
      >
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <span class="font-semibold text-gray-700">Sanity Check</span>
          </div>
          <span class={"text-xs font-bold px-3 py-1 rounded-full #{get_rating_class(get_sanity_score(assigns))}"}>
            <%= get_rating(get_sanity_score(assigns)) %>
          </span>
        </div>
        <div class={"text-4xl font-bold mb-2 #{get_score_color(get_sanity_score(assigns))}"}>
          <%= get_sanity_score(assigns) %><span class="text-xl text-gray-400">/100</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-3 mb-3">
          <div class={"h-3 rounded-full transition-all duration-500 #{get_bar_color(get_sanity_score(assigns))}"} style={"width: #{get_sanity_score(assigns)}%"}></div>
        </div>
        <p class="text-sm text-gray-600"><%= get_sanity_message(assigns) %></p>
        <p class="text-xs text-amber-600 mt-3 flex items-center gap-1 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Click for detailed feedback
        </p>
      </div>
    </div>
  </div>

  <!-- Feedback Panels -->
  <%= if Map.get(assigns, :show_completeness_feedback, false) do %>
    <div class="bg-blue-50 border-l-4 border-blue-500 rounded-lg p-6 mb-6 shadow-md animate-fade-in">
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-blue-900">Completeness Feedback</h3>
        </div>
        <button phx-click="toggle_feedback" phx-value-section="completeness" class="text-blue-600 hover:text-blue-800 p-2 hover:bg-blue-100 rounded-lg transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <%= if has_completeness_feedback?(assigns) do %>
        <ul class="space-y-3">
          <%= for item <- get_completeness_feedback(assigns) do %>
            <li class="flex items-start gap-3 text-sm text-blue-900 bg-white rounded-lg p-3">
              <span class="text-blue-600 mt-1 shrink-0">●</span>
              <span class="flex-1"><%= item %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="bg-white rounded-lg p-4 flex items-center gap-3">
          <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-blue-800">All sections are complete. Excellent work!</p>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= if Map.get(assigns, :show_relevance_feedback, false) do %>
    <div class="bg-purple-50 border-l-4 border-purple-500 rounded-lg p-6 mb-6 shadow-md animate-fade-in">
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-purple-500 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-purple-900">Relevance Analysis</h3>
        </div>
        <button phx-click="toggle_feedback" phx-value-section="relevance" class="text-purple-600 hover:text-purple-800 p-2 hover:bg-purple-100 rounded-lg transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <%= if has_relevance_feedback?(assigns) do %>
        <div class="space-y-4">
          <%= if get_relevance_justification(assigns) do %>
            <div class="bg-white rounded-lg p-4">
              <p class="text-sm font-bold text-purple-900 mb-2 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                Detailed Analysis:
              </p>
              <p class="text-sm text-purple-800 leading-relaxed"><%= get_relevance_justification(assigns) %></p>
            </div>
          <% end %>
          <%= if has_matching_keywords?(assigns) do %>
            <div class="bg-white rounded-lg p-4">
              <p class="text-sm font-bold text-purple-900 mb-3 flex items-center gap-2">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Matching Skills:
              </p>
              <div class="flex flex-wrap gap-2">
                <%= for keyword <- get_matching_keywords(assigns) do %>
                  <span class="px-3 py-1.5 bg-green-100 text-green-800 rounded-lg text-sm font-medium border border-green-200"><%= keyword %></span>
                <% end %>
              </div>
            </div>
          <% end %>
          <%= if has_missing_keywords?(assigns) do %>
            <div class="bg-white rounded-lg p-4">
              <p class="text-sm font-bold text-purple-900 mb-3 flex items-center gap-2">
                <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Recommended Skills to Add:
              </p>
              <div class="flex flex-wrap gap-2">
                <%= for keyword <- get_missing_keywords(assigns) do %>
                  <span class="px-3 py-1.5 bg-red-100 text-red-800 rounded-lg text-sm font-medium border border-red-200"><%= keyword %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="bg-white rounded-lg p-4 flex items-center gap-3">
          <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-purple-800">Your skills are highly relevant to the selected job role!</p>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= if Map.get(assigns, :show_sanity_feedback, false) do %>
    <div class="bg-amber-50 border-l-4 border-amber-500 rounded-lg p-6 mb-6 shadow-md animate-fade-in">
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-amber-900">Quality Check Issues</h3>
        </div>
        <button phx-click="toggle_feedback" phx-value-section="sanity" class="text-amber-600 hover:text-amber-800 p-2 hover:bg-amber-100 rounded-lg transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <%= if has_sanity_issues?(assigns) do %>
        <ul class="space-y-3">
          <%= for issue <- get_sanity_issues(assigns) do %>
            <li class="flex items-start gap-3 text-sm text-amber-900 bg-white rounded-lg p-3 border border-amber-200">
              <span class="text-amber-600 mt-1 shrink-0">⚠</span>
              <span class="flex-1"><%= issue %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="bg-white rounded-lg p-4 flex items-center gap-3">
          <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-amber-800">No inconsistencies found. Your profile is well-structured!</p>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Continue with comprehensive sections in next part -->
</div>
