<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Preview unavailable · Vyaasa</title>
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
        color: #212529;
        padding: 1.5rem;
      }
      .wrap { text-align: center; max-width: 30rem; }
      h1 { margin: 0 0 0.6rem; font-size: 1.35rem; font-weight: 600; }
      p { margin: 0 0 0.6rem; color: #6c757d; font-size: 0.9rem; line-height: 1.6; }
      .file {
        display: inline-block; margin-bottom: 1rem; padding: 0.3rem 0.7rem;
        background: #fff; border: 1px solid #e9ecef; border-radius: 0.25rem;
        font-size: 0.8rem; color: #495057; word-break: break-all;
      }
      .detail {
        margin-top: 1rem; font-size: 0.75rem; color: #adb5bd;
        word-break: break-word;
      }
      .btn {
        display: inline-block; margin-top: 1.25rem; padding: 0.6rem 1.5rem;
        background: #FF8B00; color: #fff; text-decoration: none;
        border-radius: 0.25rem; font-weight: 500;
      }
      .btn:hover { opacity: 0.9; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <span class="file">{@filename}</span>
      <h1>{@title}</h1>
      <p>{@message}</p>
      <p :if={@hint not in [nil, ""]}>{@hint}</p>
      <a href={@download_url} class="btn">Download the file</a>
      <p :if={@detail not in [nil, ""]} class="detail">{@detail}</p>
    </div>
  </body>
</html>
