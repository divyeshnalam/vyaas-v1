<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>JAM Session Report</title>
    <style><%= raw(common_styles()) %></style>
    <style>
      .sub-scores {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 8px;
      }
      .sub {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 10px 8px;
        text-align: center;
        background: #f9fafb;
      }
      .sub .v { font-size: 15pt; font-weight: 700; color: #111827; }
      .sub .v small { font-size: 9pt; color: #6b7280; font-weight: 500; }
      .sub .k { font-size: 8pt; color: #6b7280; text-transform: uppercase; letter-spacing: 0.4px; margin-top: 4px; }
      .transcript {
        font-size: 10pt;
        line-height: 1.6;
        color: #374151;
        white-space: pre-wrap;
        max-height: 220px;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <div class="report">
      <.report_watermark watermark_src={@watermark_src} />
      <.report_header logo_src={@logo_src} student={@student} generated_at_display={@generated_at_display} />

      <section class="title-block">
        <div>
          <h1>JAM Session Report</h1>
          <p>{@topic_title}</p>
        </div>
        <span
          class="badge"
          style={"background: #{tint_hex(@performance_color)}; color: #{color_hex(@performance_color)};"}
        >
          {@performance_label}
        </span>
      </section>

      <section class="card">
        <h3>Overall Performance</h3>
        <div class="score-hero">
          <div class="gauge">
            <svg width="130" height="130" viewBox="0 0 130 130">
              <circle cx="65" cy="65" r="55" stroke="#e5e7eb" stroke-width="10" fill="none" />
              <circle
                cx="65"
                cy="65"
                r="55"
                stroke={color_hex(@performance_color)}
                stroke-width="10"
                fill="none"
                stroke-linecap="round"
                stroke-dasharray={Float.round(2 * 3.14159 * 55, 2)}
                stroke-dashoffset={Float.round(2 * 3.14159 * 55 * (1 - clamp_pct(@final_score) / 100), 2)}
              />
            </svg>
            <div class="center">
              <div class="score">{round(@final_score)}<small style="font-size: 9pt; color: #6b7280; font-weight: 500;">/100</small></div>
              <div class="label">Final Score</div>
            </div>
          </div>
          <div class="score-summary">
            <div class="pct" style={"color: #{color_hex(@performance_color)};"}>
              {round(@final_score)}%
            </div>
            <div class="verdict" style={"color: #{color_hex(@performance_color)};"}>
              {@performance_label}
            </div>
            <div class="sub">
              Spoke for {@speech_duration}s · {@word_count} words
            </div>
          </div>
        </div>
      </section>

      <section class="card">
        <h3>Sub-scores</h3>
        <div class="sub-scores">
          <div class="sub"><div class="v">{@clarity || 0}<small>/10</small></div><div class="k">Clarity</div></div>
          <div class="sub"><div class="v">{@structure || 0}<small>/10</small></div><div class="k">Structure</div></div>
          <div class="sub"><div class="v">{@relevance || 0}<small>/10</small></div><div class="k">Relevance</div></div>
          <div class="sub"><div class="v">{@impact || 0}<small>/10</small></div><div class="k">Impact</div></div>
          <div class="sub"><div class="v">{@confidence || 0}<small>/10</small></div><div class="k">Confidence</div></div>
        </div>
      </section>

      <section :if={@overall_summary && @overall_summary != ""} class="card">
        <h3>Overall Summary</h3>
        <div class="prose"><p>{@overall_summary}</p></div>
      </section>

      <section :if={@strengths != [] or @improvements != []} class="card">
        <div class="grid-2">
          <div>
            <h4 class="section">Strengths</h4>
            <ul class="tight">
              <li :for={item <- @strengths}>{item}</li>
              <li :if={@strengths == []} style="color: #9ca3af;">—</li>
            </ul>
          </div>
          <div>
            <h4 class="section">Areas to Improve</h4>
            <ul class="tight">
              <li :for={item <- @improvements}>{item}</li>
              <li :if={@improvements == []} style="color: #9ca3af;">—</li>
            </ul>
          </div>
        </div>
      </section>

      <section :if={map_size(@detailed_feedback) > 0} class="card">
        <h3>Detailed Feedback</h3>
        <div :for={{key, text} <- Map.to_list(@detailed_feedback)} style="margin-bottom: 8px;">
          <h4 class="section" style="margin-bottom: 2px;">{humanize_key(key)}</h4>
          <div class="prose"><p>{text}</p></div>
        </div>
      </section>

      <section :if={@transcript && @transcript != ""} class="card">
        <h3>Transcript</h3>
        <div class="transcript">{@transcript}</div>
      </section>

      <.report_footer generated_at_display={@generated_at_display} />
    </div>
  </body>
</html>
