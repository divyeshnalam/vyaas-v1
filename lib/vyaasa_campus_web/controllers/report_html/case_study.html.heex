<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Case Study Report</title>
    <style><%= raw(common_styles()) %></style>
    <style>
      .competency { margin-bottom: 12px; }
      .competency:last-child { margin-bottom: 0; }
      .competency .head {
        display: flex;
        justify-content: space-between;
        font-size: 10pt;
        color: #374151;
        margin-bottom: 4px;
      }
      .competency .head .label { font-weight: 600; color: #111827; }
      .competency .bar {
        width: 100%;
        background: #e5e7eb;
        border-radius: 9999px;
        height: 7px;
        overflow: hidden;
      }
      .competency .bar > span { display: block; height: 100%; border-radius: 9999px; }
      .competency .reason { font-size: 9.5pt; color: #4b5563; margin-top: 4px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <div class="report">
      <.report_watermark watermark_src={@watermark_src} />
      <.report_header logo_src={@logo_src} student={@student} generated_at_display={@generated_at_display} />

      <section class="title-block">
        <div>
          <h1>Case Study</h1>
          <p>
            {@scenario_title}<span :if={@specialization}> · {@specialization}</span>
          </p>
        </div>
        <span
          class="badge"
          style={"background: #{tint_hex(@performance_color)}; color: #{color_hex(@performance_color)};"}
        >
          {@verdict || @performance_label}
        </span>
      </section>

      <section class="card">
        <h3>Overall Score</h3>
        <div class="score-hero">
          <div class="gauge">
            <svg width="130" height="130" viewBox="0 0 130 130">
              <circle cx="65" cy="65" r="55" stroke="#e5e7eb" stroke-width="10" fill="none" />
              <circle
                cx="65"
                cy="65"
                r="55"
                stroke={color_hex(@performance_color)}
                stroke-width="10"
                fill="none"
                stroke-linecap="round"
                stroke-dasharray={Float.round(2 * 3.14159 * 55, 2)}
                stroke-dashoffset={Float.round(2 * 3.14159 * 55 * (1 - clamp_pct(@total_score) / 100), 2)}
              />
            </svg>
            <div class="center">
              <div class="score">{round(@total_score)}<small style="font-size: 9pt; color: #6b7280; font-weight: 500;">/100</small></div>
              <div class="label">Overall</div>
            </div>
          </div>
          <div class="score-summary">
            <div class="pct" style={"color: #{color_hex(@performance_color)};"}>
              {round(@total_score)}%
            </div>
            <div class="verdict" style={"color: #{color_hex(@performance_color)};"}>
              {@verdict || @performance_label}
            </div>
            <div :if={@summary} class="sub">{@summary}</div>
          </div>
        </div>
      </section>

      <section class="card">
        <h3>Evaluation Breakdown</h3>
        <%= for {label, val, max, feedback} <- @scores do %>
          <div class="competency">
            <div class="head">
              <span class="label">{label}</span>
              <span>{val}/{max}</span>
            </div>
            <div class="bar">
              <span style={"width: #{clamp_pct(val / max * 100)}%; background: #{color_hex(perf_color(val / max * 100))};"}></span>
            </div>
            <div :if={feedback} class="reason">{feedback}</div>
          </div>
        <% end %>
      </section>

      <section :if={@strengths != [] or @improvements != []} class="card">
        <div class="grid-2">
          <div>
            <h4 class="section">Strengths</h4>
            <ul class="tight">
              <li :for={s <- @strengths}>{s}</li>
              <li :if={@strengths == []} style="color: #9ca3af;">—</li>
            </ul>
          </div>
          <div>
            <h4 class="section">Areas for Improvement</h4>
            <ul class="tight">
              <li :for={a <- @improvements}>{a}</li>
              <li :if={@improvements == []} style="color: #9ca3af;">—</li>
            </ul>
          </div>
        </div>
      </section>

      <.report_footer generated_at_display={@generated_at_display} />
    </div>
  </body>
</html>
