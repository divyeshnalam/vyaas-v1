<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Behavioral Assessment Report</title>
    <style><%= raw(common_styles()) %></style>
    <style>
      .competency { margin-bottom: 10px; }
      .competency:last-child { margin-bottom: 0; }
      .competency .head {
        display: flex;
        justify-content: space-between;
        font-size: 10pt;
        color: #374151;
        margin-bottom: 4px;
      }
      .competency .head .label { font-weight: 600; color: #111827; }
      .competency .bar {
        width: 100%;
        background: #e5e7eb;
        border-radius: 9999px;
        height: 7px;
        overflow: hidden;
      }
      .competency .bar > span { display: block; height: 100%; border-radius: 9999px; }
      .competency .reason { font-size: 9.5pt; color: #4b5563; margin-top: 4px; line-height: 1.5; }
      .scenario {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 10px 12px;
        margin-bottom: 8px;
        background: #f9fafb;
      }
      .scenario .q { font-weight: 600; color: #111827; font-size: 10pt; }
      .scenario .meta { font-size: 8.5pt; color: #6b7280; margin-top: 2px; }
      .scenario .r { font-size: 9.5pt; color: #374151; margin-top: 6px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <div class="report">
      <.report_watermark watermark_src={@watermark_src} />
      <.report_header logo_src={@logo_src} student={@student} generated_at_display={@generated_at_display} />

      <section class="title-block">
        <div>
          <h1>Behavioral Assessment</h1>
          <p>
            {@candidate_name}<span :if={@role}> · {@role}</span><span :if={@education}> · {@education}</span>
          </p>
        </div>
        <span
          class="badge"
          style={"background: #{tint_hex(@performance_color)}; color: #{color_hex(@performance_color)};"}
        >
          {@performance_label}
        </span>
      </section>

      <section class="card">
        <h3>Overall Score</h3>
        <div class="score-hero">
          <div class="gauge">
            <svg width="130" height="130" viewBox="0 0 130 130">
              <circle cx="65" cy="65" r="55" stroke="#e5e7eb" stroke-width="10" fill="none" />
              <circle
                cx="65"
                cy="65"
                r="55"
                stroke={color_hex(@performance_color)}
                stroke-width="10"
                fill="none"
                stroke-linecap="round"
                stroke-dasharray={Float.round(2 * 3.14159 * 55, 2)}
                stroke-dashoffset={Float.round(2 * 3.14159 * 55 * (1 - clamp_pct(@overall_score) / 100), 2)}
              />
            </svg>
            <div class="center">
              <div class="score">{round(@overall_score)}<small style="font-size: 9pt; color: #6b7280; font-weight: 500;">/100</small></div>
              <div class="label">Overall</div>
            </div>
          </div>
          <div class="score-summary">
            <div class="pct" style={"color: #{color_hex(@performance_color)};"}>
              {round(@overall_score)}%
            </div>
            <div class="verdict" style={"color: #{color_hex(@performance_color)};"}>
              {@performance_label}
            </div>
            <div :if={@summary} class="sub">{@summary}</div>
          </div>
        </div>
      </section>

      <section class="card">
        <h3>Competencies</h3>
        <%= for {label, key, val} <- [
          {"Work Ethics & Reliability", "work_ethics_and_reliability", @scores.work_ethics},
          {"Teamwork & Collaboration", "teamwork_and_collaboration", @scores.teamwork},
          {"Adaptability & Learning", "adaptability_and_learning", @scores.adaptability},
          {"Leadership Potential", "leadership_potential", @scores.leadership},
          {"Communication Skills", "communication_skills", @scores.communication}
        ] do %>
          <div class="competency">
            <div class="head">
              <span class="label">{label}</span>
              <span>{val || "—"}/100</span>
            </div>
            <div class="bar">
              <span style={"width: #{clamp_pct(val || 0)}%; background: #{color_hex(perf_color(val || 0))};"}></span>
            </div>
            <div :if={Map.get(@reasoning, key)} class="reason">
              {Map.get(@reasoning, key)}
            </div>
          </div>
        <% end %>
      </section>

      <section :if={@strengths != [] or @areas_for_development != []} class="card">
        <div class="grid-2">
          <div>
            <h4 class="section">Strengths</h4>
            <ul class="tight">
              <li :for={s <- @strengths}>{s}</li>
              <li :if={@strengths == []} style="color: #9ca3af;">—</li>
            </ul>
          </div>
          <div>
            <h4 class="section">Areas for Development</h4>
            <ul class="tight">
              <li :for={a <- @areas_for_development}>{a}</li>
              <li :if={@areas_for_development == []} style="color: #9ca3af;">—</li>
            </ul>
          </div>
        </div>
      </section>

      <section :if={is_list(@completed_scenarios) and @completed_scenarios != []} class="card">
        <h3>Scenario Responses</h3>
        <div :for={s <- @completed_scenarios} class="scenario">
          <div class="q">Scenario {s["scenario_number"]}: {s["question"]}</div>
          <div class="meta">Score: {s["score"] || "—"}</div>
          <div :if={s["response"]} class="r">{s["response"]}</div>
        </div>
      </section>

      <.report_footer generated_at_display={@generated_at_display} />
    </div>
  </body>
</html>
